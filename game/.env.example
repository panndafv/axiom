# Copy to .env (same folder) and edit. Real environment variables override this file.
# Relative paths are resolved from this game/ folder.

# Port and interface the server listens on.
PORT=8787
HOST=0.0.0.0

# SQLite database file (its folder is created if missing).
DB_PATH=./data/game.db

# Shown in the sign-in message players sign with their wallet.
GAME_NAME="Drift"

# Ticker shown to players, without the $.
TOKEN_SYMBOL=DRIFT

# The token's mint address. Leave empty for dev mode: the holding check always passes.
TOKEN_MINT=

# Solana JSON-RPC endpoint for balances and payouts (use a private RPC such as Helius in production;
# the public one rate-limits). For a devnet test: https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Players must hold at least this many USD of the token to exchange fish for SOL.
MIN_HOLD_USD=30

# Testing before the token trades: wallet addresses (comma separated) that pass the holding check.
# Delete at launch.
TEST_WALLETS=

# 1 = keep TOKEN_MINT off the title screen until launch (the server still uses it).
HIDE_MINT=0

# Fish a player must have sold at the rack before they can cash any in (anti-bot: play first).
EARN_GATE=10

# Most one player can take from the pool per 24h, as a fraction of what is available (0.1 = 10%).
# Keep it above the Ghost Whale's 6.5%, or that fish could never be cashed in.
POOL_DAILY_CAP_PCT=0.1

# Most fish one wallet can cash in for SOL in any 24 hours (rarest fish get the slots first).
POOL_DAILY_FISH=30

# Pool wallet address. Set it to fund the pool on-chain ("wallet" mode); leave empty for "ledger" mode,
# where an admin records deposits with POST /api/admin/pool.
POOL_WALLET=

# Wallet mode only: SOL always left in the pool wallet for transaction fees.
POOL_RESERVE_SOL=0.05

# Automatic payouts: the pool wallet's private key (base58, as Phantom's "Export Private Key" shows
# it, or a keypair file's [..] array). With it set, every cash-in sends SOL to the player straight
# away and shows them the Solscan link; POOL_WALLET can stay empty (it is worked out from the key).
# Use a wallet made just for the pool, keep only the pool's SOL in it, and only ever put this in
# your host's secret settings, never in git or a chat. Empty = payouts are queued for you to send.
POOL_SECRET_KEY=

# mainnet or devnet. Only changes Solscan links; guessed from SOLANA_RPC_URL when empty.
SOLANA_CLUSTER=

# Priority fee for payout transactions, in micro-lamports per compute unit (10000 costs about
# 0.000002 SOL per payout). Helps payouts land when the network is busy.
PRIORITY_FEE_MICROLAMPORTS=10000

# Dev mode only (TOKEN_MINT empty): fake SOL put in a never-funded test pool at startup.
SEED_POOL_SOL=0

# Secret for the /api/admin routes (send it as the x-admin-key header). Empty disables admin routes.
ADMIN_KEY=

# Allowed browser origin for cross-origin API calls (e.g. http://localhost:5173). Empty = same origin only.
CORS_ORIGIN=

# How long a wallet sign-in stays valid, in days.
SESSION_DAYS=7

# Folder with the built client (npm run build) to serve; the API still works if it is missing.
STATIC_DIR=./dist

# Set to 1 when running behind a reverse proxy, so rate limiting uses X-Forwarded-For.
TRUST_PROXY=0

# ----------------------------------------------------------------------------------------------
# Client build settings (read by Vite at `npm run build`; the server's /api/config overrides the
# token name, symbol and mint at runtime, so usually only VITE_BUY_URL / VITE_API_URL matter).

# Shown on the title screen if the server can't be reached.
VITE_GAME_NAME="Drift"
VITE_TOKEN_SYMBOL=DRIFT
VITE_TOKEN_MINT=

# "buy" link next to the contract address (e.g. the pump.fun or Jupiter page). Empty hides it.
VITE_BUY_URL=

# X (Twitter) link in the credits.
VITE_X_URL=https://x.com/driftgamesol

# Only if the API runs on a different origin than the page (then also set CORS_ORIGIN above).
VITE_API_URL=
