{
  "manifest_version": 3,
  "name": "Terminal Router",
  "version": "0.1.0",
  "description": "Pick which terminal (Axiom, Padre or GMGN) places your buys, straight from Axiom's Instant Trade panel.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://axiom.trade/*",
    "https://trade.padre.gg/*",
    "https://gmgn.ai/*",
    "https://api.dexscreener.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*"],
      "js": ["src/config.js", "src/axiom.js"],
      "css": ["src/axiom.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://trade.padre.gg/*", "https://gmgn.ai/*"],
      "js": ["src/config.js", "src/terminal-buyer.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Terminal Router",
    "default_popup": "src/popup.html"
  }
}
